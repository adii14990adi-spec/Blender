# Pipeline outputs (CI artifacts — uploaded as artifacts / to S3, never committed)
outputs/
# Pages staging directory assembled by .github/workflows/blender-build.yml
site/

# Generated by tools/build_site.py. CI assembles these into the Pages artifact;
# only the authored sources (and the test screenshots) are tracked.
/docs/outputs/
/docs/css/
/docs/js/
/docs/vendor/
/docs/index.html
/docs/favicon.svg
/docs/manifest.json
/docs/browser-test-results.json
/docs/build_report.json
/docs/gltf-validation.jsonl

# Procedurally generated PBR texture sets (deterministic, rebuilt by the
# `uv_material` stage). Hand-authored reference maps stay tracked, and so do the
# baked sets committed with an outfit (see tools/bake_textures.py) — re-include
# their folders below.
assets/textures/*/
!assets/textures/tactical_tee_01/
!assets/textures/tactical_cargo_01/

# Node tooling (Khronos glTF Validator is installed by CI)
node_modules/
npm-debug.log*

